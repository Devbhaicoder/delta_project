<% layout("/layouts/boilerplate") %>

            <div class="row mt-3">
            <div class="offset-2 col-8">
        <h3>Edit Your Listing</h3> 
        <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" class="mb-5 needs-validation" novalidate enctype="multipart/form-data">
            <div class="mb-3">
                <label for="title" class="form-label" class="mb-3">Title</label>
                <input name="listing[title]" value="<%= listing.title %>" class="form-control" required>
                <div class="valid-feedback">Title looks good!</div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label" class="mb-3">Description</label>
                <textarea name="listing[description]" class="form-control" required><%= listing.description %></textarea>
                 <div class="invalid-feedback">Please add a description</div>
            </div>

            <div class="mb-3">  
                  <p> Original Listing Image</p>    
                   <img style="max-width:250px; height:auto;"
                        src="<%= originalImageUrl %>" alt="">
            </div>

            <div class="mb-3">
                <label for="image" class="form-label" class="mb-3">Upload New Image</label>
                <input type="file" name="listing[image]"  class="form-control" >
                 <div class="invalid-feedback">Please add Image Link</div>
            </div>

            <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label" class="mb-3">Price</label>
                <input type="number" name="listing[price]" class="form-control" required value="<%= listing.price %>">
                 <div class="invalid-feedback">Please add a valid price</div>
            </div>
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label" class="mb-3">Country</label>
                <input type="text" name="listing[country]" class="form-control" required value="<%= listing.country %>">
                 <div class="invalid-feedback">Please add a valid country name</div>
            </div>
            </div>
            <div class="mb-3">
                <label for="location" class="form-label" class="mb-3">Location</label>
                <input type="text" name="listing[location]" class="form-control" required value="<%= listing.location %>">
                 <div class="invalid-feedback">Please add a valid location name</div>
            </div>
     
            <button class="btn btn-dark edit-btn mt-3">Edit</button>
        </form>
        </div>
        </div>
